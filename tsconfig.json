{
    "compilerOptions":{
    "target": "es2017",
    "module": "es2020",
    "moduleResolution": "bundler",
    "rootDir": "app/ts",
    "outDir": "app/js",
    "noEmitOnError": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitThis": false,
    "strict": false,
    "types": ["jquery", "materialize-css", "socket.io-client"]
    },
    "include":[
        "app/ts/**/*"
    ]
}
